package string.programming;

public class CountAllTypesInString {
	public static void main(String[] args) {
		String str=" &&**^^";
		int up = 0,lw = 0,sp = 0,ws = 0;
		
		for (int i = 0; i < str.length(); i++) {
			char ch=str.charAt(i);
			if(ch>='A' && ch<='Z') {
				up++;
			}
			else if(ch>='a' && ch<='z') {
				lw++;
			}
			else if(ch == ' ') {
				ws++;
			}
			else
				sp++;
		}
		System.out.println("UpperCase: "+up+" \nLowerCase: "+lw+" \nSpecialCharacter: "+sp+" \nWhiteSpace: "+ws);
	}
}
